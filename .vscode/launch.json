{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App: Map Viewer Server",
            "type": "debugpy",
            "request": "launch",
            "module": "app.server",
            "args": [
                //"--folder", "data/locations/circleville_600_600_old",
                "--dtm", "data/loaded_tiles/Whole_Road/merged_dtm.tif",
                "--mode", "high_banks",
                "--max-workers", "25"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "LiDAR: Generate Circleville Road DTM",
            "type": "debugpy",
            "request": "launch",
            "module": "lidar.run_pipeline",
            "args": [
                "Circleville_Road_7",
                //"--area-splits", "10",
                "--pdal-workers", "10",
                "--skip-collect",
                //"--skip-download",
                //"--skip-pdal",
                "--skip-merge",
                "--skip-view"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "LiDAR: Generate Full Road DTM",
            "type": "debugpy",
            "request": "launch",
            "module": "lidar.run_pipeline",
            "args": [
                "full_road",
                "--area-splits", "10",
                "--pdal-workers", "10",
                "--skip-collect",
                "--skip-download",
                "--skip-pdal",
                //"--skip-merge",
                "--skip-view"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "LiDAR: Generate Hart Island DTM",
            "type": "debugpy",
            "request": "launch",
            "module": "lidar.run_pipeline",
            "args": [
                "Hart_Island",
                "--separate-year",
                "--skip-collect",
                "--skip-download",
                "--skip-pdal",
                "--skip-merge",
                //"--skip-view",
                "--pdal-workers", "10",
                "--sample-step", "10"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Road Model: Ridge Detection + Road Modeler",
            "type": "debugpy",
            "request": "launch",
            "module": "road_model.road_modeler",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Road Model: Chillicothe Range Searcher",
            "type": "debugpy",
            "request": "launch",
            "module": "road_model.range_searcher",
            "args": ["--mode", "chillicothe",
                //"--preview",
                "--max_workers", "1"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Road Model: Circleville Range Searcher",
            "type": "debugpy",
            "request": "launch",
            "module": "road_model.range_searcher",
            "args": [//"--preview",
                "--max_workers", "10",
                "--mode", "circleville",
                "--reverse"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Road Model: High Banks Range Searcher",
            "type": "debugpy",
            "request": "launch",
            "module": "road_model.range_searcher",
            "args": [//"--preview",
                "--max_workers", "10",
                "--mode", "high_banks",
                "--reverse"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Report: Generate Figures",
            "type": "debugpy",
            "request": "launch",
            "module": "report.run_report",
            "args": ["--only", "HB Remnant"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Report: Generate DOCX",
            "type": "debugpy",
            "request": "launch",
            "module": "report.generate_report_doc",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Quick View: DTM",
            "type": "debugpy",
            "request": "launch",
            "module": "lidar.quick_view",
            "args": [
                "--input", "data/loaded_tiles/Whole_Road/merged_dtm.tif",
                "--step", "50",
                "--workers", "8"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}