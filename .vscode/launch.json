{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App: Map Viewer Server",
            "type": "debugpy",
            "request": "launch",
            "module": "app.server",
            "args": [
                //"--folder", "data/locations/circleville_600_600_old",
                "--dtm", "data/loaded_tiles/Whole_Road/merged_dtm.tif",
                "--mode", "high_banks",
                "--max-workers", "25"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "LiDAR: Generate Circleville Road DTM",
            "type": "debugpy",
            "request": "launch",
            "module": "lidar.run_pipeline",
            "args": [
                "Circleville_Road_7",
                //"--area-splits", "10",
                "--pdal-workers", "10",
                "--skip-collect",
                //"--skip-download",
                //"--skip-pdal",
                "--skip-merge",
                "--skip-view"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "LiDAR: Generate Full Road DTM",
            "type": "debugpy",
            "request": "launch",
            "module": "lidar.run_pipeline",
            "args": [
                "full_road",
                "--area-splits", "10",
                "--pdal-workers", "10",
                "--skip-collect",
                "--skip-download",
                "--skip-pdal",
                //"--skip-merge",
                "--skip-view"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "LiDAR: Generate Hart Island DTM",
            "type": "debugpy",
            "request": "launch",
            "module": "lidar.run_pipeline",
            "args": [
                "Hart_Island",
                "--separate-year",
                "--skip-collect",
                "--skip-download",
                "--skip-pdal",
                "--skip-merge",
                //"--skip-view",
                "--pdal-workers", "10",
                "--sample-step", "10"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "LiDAR: Generate Zorro Ranch DTM",
            "type": "debugpy",
            "request": "launch",
            "module": "lidar.run_pipeline",
            "args": [
                "Zorro_Ranch",
                "--pdal-workers", "10",
                "--area-splits", "1"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Road Model: Ridge Detection + Road Modeler",
            "type": "debugpy",
            "request": "launch",
            "module": "road_model.road_modeler",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Road Model: Chillicothe Range Searcher",
            "type": "debugpy",
            "request": "launch",
            "module": "road_model.range_searcher",
            "args": ["--mode", "chillicothe",
                //"--preview",
                "--max_workers", "1"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Road Model: Circleville Range Searcher",
            "type": "debugpy",
            "request": "launch",
            "module": "road_model.range_searcher",
            "args": [//"--preview",
                "--max_workers", "10",
                "--mode", "circleville",
                "--reverse"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Road Model: High Banks Range Searcher",
            "type": "debugpy",
            "request": "launch",
            "module": "road_model.range_searcher",
            "args": [//"--preview",
                "--max_workers", "10",
                "--mode", "high_banks",
                "--reverse"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Report: Generate Figures",
            "type": "debugpy",
            "request": "launch",
            "module": "report.run_report",
            "args": ["--workers", "10"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Report: Generate DOCX",
            "type": "debugpy",
            "request": "launch",
            "module": "report.generate_report_doc",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Quick View: DTM",
            "type": "debugpy",
            "request": "launch",
            "module": "lidar.quick_view",
            "args": [
                "--input", "data/loaded_tiles/Whole_Road/merged_dtm.tif",
                "--step", "50",
                "--workers", "8"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Prepare Sites (download LiDAR)",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_builder.prepare",
            "args": [
                //"--only", "Newark_Octagon_and_Observatory_Circle",
                //"--force"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Builder App (label sites)",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_builder.server",
            "args": ["--port", "5001"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Build Dataset",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_processor.build_dataset",
            "args": [
                "--name", "v2"
                //"--only", "Seip_Earthworks", "Fort_Ancient"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Build Dataset (mound vs earthwork classes)",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_processor.build_dataset",
            "args": [
                "--name", "v2_classes",
                "--classes", "mound", "earthwork"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Train Model",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_model.train",
            "args": [
                "--dataset", "data/earthworks/dataset/v2",
                //"--epochs", "40",
                //"--batch-size", "4",
                //"--device", "cuda",
                //"--resume",
                "--workers", "2"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Colab Bundle (code + dataset)",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_model.colab_bundle",
            "args": [
                "--dataset", "data/earthworks/dataset/v2"
                //"--out", "data/earthworks/colab"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Colab Bundle (code only)",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_model.colab_bundle",
            "args": [
                "--dataset", "data/earthworks/dataset/v2",
                "--code-only"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Build Ohio Tile Index",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_inference.tile_index",
            "args": [
                //"--bbox", "-82.6", "39.9", "-82.4", "40.1"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Statewide Scan",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_inference.scan",
            "args": [
                "--run", "ohio_v1",
                "--checkpoint", "data/earthworks/models/v1/best.pt"
                //"--bbox", "-82.50", "40.00", "-82.40", "40.08",
                //"--max-blocks", "4",
                //"--retry-failed",
                //"--device", "cuda"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Export Scan Candidates",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_inference.scan",
            "args": [
                "--run", "ohio_v1",
                "--export"
                //"--min-score", "0.7"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Earthworks: Import Candidates for Review",
            "type": "debugpy",
            "request": "launch",
            "module": "earthwork_builder.import_candidates",
            "args": [
                "--run", "ohio_v1",
                "--min-score", "0.7",
                "--limit", "50"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}